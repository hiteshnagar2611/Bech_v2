#!/bin/bash
#PBS -N new_models_test
#PBS -q apolloq
#PBS -l select=1:host=gnode6:ncpus=10:ngpus=1
#PBS -l walltime=2:00:00
#PBS -joe
#PBS -P external

cd $PBS_O_WORKDIR
mkdir -p results figures logs

eval "$(conda shell.bash hook)"

echo "=== Test started at $(date) ==="
nvidia-smi --query-gpu=index,name,memory.total,memory.used --format=csv

# --- Protein models (esm_meta) ---
conda activate esm_meta

echo ""
echo "=== Test ProtBERT ==="
python run_benchmark.py --model protbert --device cuda --batch_size 16 2>&1 | tail -5
echo "Results:" && wc -l results/protbert_results.tsv 2>/dev/null || echo "FAILED"

echo ""
echo "=== Test ESM-1v ==="
python run_benchmark.py --model esm1v --device cuda --batch_size 16 2>&1 | tail -5
echo "Results:" && wc -l results/esm1v_results.tsv 2>/dev/null || echo "FAILED"

echo ""
echo "=== Test Ankh ==="
python run_benchmark.py --model ankh --device cuda --batch_size 8 2>&1 | tail -5
echo "Results:" && wc -l results/ankh_results.tsv 2>/dev/null || echo "FAILED"

# --- DNA models (dna_env) ---
conda activate dna_env

echo ""
echo "=== Test DNABERT-1 ==="
python run_benchmark.py --model dnabert1 --device cuda --batch_size 8 2>&1 | tail -5
echo "Results:" && wc -l results/dnabert1_results.tsv 2>/dev/null || echo "FAILED"

echo ""
echo "=== Test Gena-LM ==="
python run_benchmark.py --model genalm --device cuda --batch_size 8 2>&1 | tail -5
echo "Results:" && wc -l results/genalm_results.tsv 2>/dev/null || echo "FAILED"

echo ""
echo "=== Skipping Caduceus (mamba_ssm won't compile - GCC too old) ==="

echo ""
echo "=== Test finished at $(date) ==="
