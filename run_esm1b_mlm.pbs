#!/bin/bash
#PBS -N esm1b_mlm
#PBS -q apolloq
#PBS -l select=1:host=gnode6:ncpus=10:ngpus=1
#PBS -l walltime=720:00:00
#PBS -joe
#PBS -P external

cd $PBS_O_WORKDIR
eval "$(conda shell.bash hook)"

echo "=== Job started at $(date) ==="
nvidia-smi --query-gpu=index,name,memory.used --format=csv

echo ""
echo "=== ESM1b masked marginal log-likelihood ==="
conda activate esm_meta
python run_benchmark.py --model esm1b_mlm --device cuda --batch_size 32

echo ""
echo "=== Re-run analysis ==="
python analysis.py

echo ""
echo "=== Job finished at $(date) ==="
