#!/bin/bash
#PBS -N esm1b_mlm
#PBS -q apolloq
#PBS -l select=1:host=gnode6:ncpus=10:ngpus=1
#PBS -l walltime=2:00:00
#PBS -joe
#PBS -P external

cd $PBS_O_WORKDIR

eval "$(conda shell.bash hook)"
conda activate esm_meta

echo "=== ESM1b-MLM started at $(date) ==="
rm -f results/esm1b_mlm_checkpoint.pkl results/esm1b_mlm_results.tsv

python run_benchmark.py --model esm1b_mlm --device cuda --batch_size 16 2>&1 | tail -10

echo ""
echo "=== ESM1b-MLM finished at $(date) ==="

if [ -f results/esm1b_mlm_results.tsv ]; then
    echo "Results: $(wc -l < results/esm1b_mlm_results.tsv) lines"
else
    echo "MISSING results/esm1b_mlm_results.tsv"
fi
