#!/bin/bash
#PBS -N ankh_mlm_fix
#PBS -q apolloq
#PBS -l select=1:host=gnode6:ncpus=10:ngpus=1
#PBS -l walltime=4:00:00
#PBS -joe
#PBS -P external

cd $PBS_O_WORKDIR

eval "$(conda shell.bash hook)"
conda activate esm_meta

echo "=== Ankh-MLM (encoder-only) started at $(date) ==="
rm -f results/ankh_mlm_checkpoint.pkl results/ankh_mlm_results.tsv

python run_benchmark.py --model ankh_mlm --device cuda --batch_size 16 2>&1 | tail -20

echo ""
echo "=== Ankh-MLM finished at $(date) ==="

if [ -f results/ankh_mlm_results.tsv ]; then
    echo "Results: $(wc -l < results/ankh_mlm_results.tsv) lines"
else
    echo "MISSING results/ankh_mlm_results.tsv"
fi
