#!/bin/bash
#PBS -N protein_mlm_fix
#PBS -q apolloq
#PBS -l select=1:host=gnode6:ncpus=10:ngpus=1
#PBS -l walltime=8:00:00
#PBS -joe
#PBS -P external

cd $PBS_O_WORKDIR

eval "$(conda shell.bash hook)"
conda activate esm3

echo "=== Protein MLM fix started at $(date) ==="

# ESM-1v-MLM (needs fair-esm + embedding_utils.py fix)
echo ""
echo "=== ESM-1v-MLM ==="
python run_benchmark.py --model esm1v_mlm --device cuda --batch_size 32 2>&1 | tail -5

# ProtT5-MLM (needs sentencepiece)
echo ""
echo "=== ProtT5-MLM ==="
python run_benchmark.py --model prott5_mlm --device cuda --batch_size 16 2>&1 | tail -5

# ESM3-MLM (needs esm.models)
echo ""
echo "=== ESM3-MLM ==="
python run_benchmark.py --model esm3_mlm --device cuda --batch_size 4 2>&1 | tail -5

echo ""
echo "=== Protein MLM fix finished at $(date) ==="

# List results
echo ""
echo "Results:"
for f in results/esm1v_mlm_results.tsv results/prott5_mlm_results.tsv results/esm3_mlm_results.tsv; do
    if [ -f "$f" ]; then
        echo "  $(wc -l < $f) $f"
    else
        echo "  MISSING $f"
    fi
done
