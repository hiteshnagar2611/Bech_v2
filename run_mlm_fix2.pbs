#!/bin/bash
#PBS -N mlm_fix2
#PBS -q apolloq
#PBS -l select=1:host=gnode6:ncpus=10:ngpus=1
#PBS -l walltime=8:00:00
#PBS -joe
#PBS -P external

cd $PBS_O_WORKDIR

eval "$(conda shell.bash hook)"

echo "=== MLM fix2 started at $(date) ==="

# --- ESM-1v-MLM (needs fair-esm → esm_meta env) ---
conda activate esm_meta
echo ""
echo "=== ESM-1v-MLM (esm_meta) ==="
python run_benchmark.py --model esm1v_mlm --device cuda --batch_size 32 2>&1 | tail -5

# --- ProtT5-MLM (needs sentencepiece → esm_meta env) ---
echo ""
echo "=== ProtT5-MLM (esm_meta) ==="
python run_benchmark.py --model prott5_mlm --device cuda --batch_size 16 2>&1 | tail -5

# --- ESM3-MLM (needs esm.models → esm3 env) ---
conda activate esm3
echo ""
echo "=== ESM3-MLM (esm3) ==="
python run_benchmark.py --model esm3_mlm --device cuda --batch_size 1 2>&1 | tail -5

# --- DNA models (all in dna_env) ---
conda activate dna_env
echo ""
echo "=== DNABERT-1-MLM ==="
python run_benchmark.py --model dnabert1_mlm --device cuda --batch_size 32 2>&1 | tail -5

echo ""
echo "=== DNABERT-2-MLM ==="
python run_benchmark.py --model dnabert2_mlm --device cuda --batch_size 16 2>&1 | tail -5

echo ""
echo "=== Gena-LM-MLM ==="
python run_benchmark.py --model genalm_mlm --device cuda --batch_size 16 2>&1 | tail -5

echo ""
echo "=== NT-v2-MLM ==="
python run_benchmark.py --model ntv2_mlm --device cuda --batch_size 16 2>&1 | tail -5

echo ""
echo "=== MLM fix2 finished at $(date) ==="

echo ""
echo "Results:"
for f in results/esm1v_mlm_results.tsv results/prott5_mlm_results.tsv results/esm3_mlm_results.tsv results/dnabert1_mlm_results.tsv results/dnabert2_mlm_results.tsv results/genalm_mlm_results.tsv results/ntv2_mlm_results.tsv; do
    if [ -f "$f" ]; then
        echo "  $(wc -l < $f) $f"
    else
        echo "  MISSING $f"
    fi
done
